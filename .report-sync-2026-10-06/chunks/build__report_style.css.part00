@font-face{font-family:Report;src:url('/usr/share/fonts/truetype/nanum/NanumBarunGothic.ttf');font-weight:400}
@font-face{font-family:Report;src:url('/usr/share/fonts/truetype/nanum/NanumBarunGothicBold.ttf');font-weight:700}
@font-face{font-family:SerifKR;src:url('/usr/share/fonts/truetype/nanum/NanumMyeongjo.ttf');font-weight:400}
@page{size:A4;margin:16mm 17mm 16mm 17mm;@top-left{content:'NEURAL MEMORY  /  RESEARCH INTELLIGENCE';font-family:Report;font-size:7pt;color:#71818e;letter-spacing:.6pt}@top-right{content:'OCTOBER 2026  ·  VOL. 02';font-family:Report;font-size:7pt;color:#71818e}@bottom-left{content:'MELETE RESEARCH  |  Evidence • State • Compute';font-family:Report;font-size:7pt;color:#71818e}@bottom-right{content:counter(page) ' / ' counter(pages);font-family:Report;font-size:8pt;color:#173447}}
@page cover{margin:0;@top-left{content:none}@top-right{content:none}@bottom-left{content:none}@bottom-right{content:none}}
*{box-sizing:border-box}html{font-family:Report,sans-serif;color:#183447;font-size:10pt;line-height:1.58}body{margin:0}p{margin:0 0 3.1mm;text-align:justify;word-break:normal;overflow-wrap:anywhere;orphans:3;widows:3}strong{font-weight:700;color:#09263c}a{color:#067d83;text-decoration:none}h1,h2,h3,h4{margin:0;font-weight:700;line-height:1.3}h2{font-size:23pt;letter-spacing:-.6pt;bookmark-level:1;margin:2.3mm 0 3mm}h3{font-size:12pt;margin:4mm 0 2mm;bookmark-level:none}h4{font-size:10pt;margin:2.5mm 0 1mm;bookmark-level:none}.page{break-after:page;position:relative}.page:last-child{break-after:auto}.eyebrow{font-size:8pt;font-weight:700;letter-spacing:1pt;color:#007f85;border-top:2.5pt solid #087f85;padding-top:3mm}.deck{font-size:11.4pt;line-height:1.55;color:#5b6d78;margin:0 0 5mm;word-break:keep-all}.row{display:flex;gap:6mm;align-items:flex-start}.col{flex:1;min-width:0}.col.wide{flex:1.7}.rule{height:1px;background:#d7e1e6;margin:4mm 0}.small{font-size:8.6pt;line-height:1.5}.muted{color:#647782}.kicker{font-size:8pt;letter-spacing:1pt;font-weight:700;color:#087f85}.panel{padding:4.2mm 4.8mm;background:#edf5f5;border-radius:2mm;margin:4mm 0;break-inside:avoid}.panel.warn{background:#fff4e4;border-left:3pt solid #d09237}.panel.dark{background:#112f43;color:#e6f1f3}.panel.dark strong,.panel.dark h3{color:#fff}.panel h3{margin-top:0}.quote{font-size:16pt;line-height:1.5;letter-spacing:-.3pt;margin:5mm 0;color:#0c777d;font-weight:700}.statrow{display:flex;gap:4mm;margin:5mm 0}.stat{flex:1;padding:4mm 4mm;border-top:2px solid #0b898b;background:#f1f6f7}.stat .value{font-size:28pt;color:#0c7a81;font-weight:700;line-height:1.2}.stat .label{font-size:9pt;margin-top:2mm}.stat .note{font-size:7.8pt;line-height:1.45;margin-top:1.5mm;color:#657a83}.badge{display:inline-block;font-size:7.7pt;line-height:1.5;padding:.5mm 2mm;background:#e7f2f0;color:#116d71;border-radius:1mm;margin-right:1mm}.badge.hyp{background:#fff0d8;color:#8b5e1c}.badge.emp{background:#e9eff8;color:#304e7a}.cite{font-size:8pt;white-space:nowrap;color:#087f85}.figure{margin:4mm 0 4mm;break-inside:avoid}.figure svg{display:block;width:100%;height:auto}.caption{font-size:8.1pt;color:#62727e;line-height:1.5;margin-top:2.2mm;text-align:left}.caption strong{color:#274454}.tablewrap{margin:4mm 0;break-inside:avoid}.tblcap{font-size:9pt;font-weight:700;color:#116c72;margin:0 0 2mm}table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:8.9pt;line-height:1.48}th{background:#123449;color:white;text-align:left;font-weight:700;padding:2.6mm 3mm;border-right:1px solid #365165}td{padding:2.8mm 3mm;vertical-align:top;border-bottom:1px solid #dce5e9;word-break:normal;overflow-wrap:anywhere}tbody tr:nth-child(even){background:#f1f5f6}td strong{color:#123c50}.compact td{padding:2mm 2.5mm;font-size:8.2pt}.compact th{padding:2mm 2.5mm;font-size:8.4pt}.formula{background:#f0f5f7;padding:4mm 5mm;margin:4mm 0;font-family:Report;font-size:12pt;text-align:center;letter-spacing:.2pt}.formula .small{display:block;font-size:8.2pt;color:#647781;margin-top:2mm}.sourcebar{border-top:1px solid #d3e0e5;padding-top:2.5mm;margin-top:5mm;font-size:8pt;color:#647782}.tocrow{display:flex;padding:3mm 0;border-bottom:1px solid #dce6e9;font-size:11pt}.tocrow .tocnum{width:12mm;font-weight:700;color:#00838a}.tocrow a{flex:1;color:#173447}.tocrow a:after{content:target-counter(attr(href),page);float:right;color:#718391;font-size:10pt}.card{padding:3.5mm 4mm;border:1px solid #d9e5e7;border-radius:1.5mm;margin-bottom:3mm;break-inside:avoid}.card h3{margin:0 0 1.4mm;font-size:11.3pt}.card .meta{font-size:7.8pt;color:#657883;margin-bottom:1.3mm}.card p{font-size:9pt;line-height:1.5;margin:0}.refitem{border-bottom:1px solid #d9e5e9;padding:2.35mm 0;break-inside:avoid}.refitem .reftitle{font-weight:700;font-size:9.7pt;line-height:1.4}.refitem .refmeta{font-size:8pt;color:#647985;margin:1mm 0}.refitem .refnote{font-size:8.4pt;line-height:1.48}.refitem a.url{display:block;font-size:7.8pt;line-height:1.35;overflow-wrap:anywhere;margin-top:1mm}.cover{page:cover;width:210mm;height:297mm;position:relative;background:#09283c;color:#fff;padding:20mm 19mm;overflow:hidden;break-after:page}.cover .series{font-size:9pt;letter-spacing:1.9pt;color:#77cecd}.cover h1{font-size:40pt;line-height:1.11;letter-spacing:-1.2pt;bookmark-level:none;margin-top:15mm}.cover .ko{font-size:22pt;line-height:1.4;color:#dceeee;margin-top:5mm;font-weight:700}.cover .sub{font-size:11.6pt;line-height:1.7;color:#abc7d3;margin-top:6mm}.cover .foot{position:absolute;bottom:15mm;left:19mm;right:19mm;border-top:1px solid #446271;padding-top:4mm;font-size:8.7pt;color:#b1ccd7}.cover svg{position:absolute;left:13mm;top:136mm;width:185mm;height:auto}.endnote{font-size:8.2pt;color:#6f7e85;line-height:1.5;margin-top:3mm}.measure{padding:3mm;background:#f2f7f8;border-left:2px solid #0b7f85;margin:3mm 0}.measure h4{margin-top:0}.check{color:#087f85;font-weight:700}.page.index p{font-size:8.8pt}.manualnum{font-weight:700;color:#0b7f85}code{font-family:Report;font-size:9pt;background:#edf2f4;padding:0 .6mm}.nobr{white-space:nowrap}

#measurement table{font-size:8.6pt}#measurement td{padding:2.4mm 3mm}#measurement .panel{margin-top:3mm;padding:3.5mm 4.8mm}
