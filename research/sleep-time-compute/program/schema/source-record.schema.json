{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-memory.local/schema/stc/source-record.schema.json",
  "title": "Sleep-Time Compute Source Record",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "source_type",
    "primary",
    "status",
    "canonical_url",
    "immutable",
    "published_at",
    "accessed_at",
    "rights"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^SRC-STC-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "paper",
        "official_documentation",
        "official_repository",
        "official_release_note",
        "dataset",
        "standard",
        "patent"
      ]
    },
    "primary": {
      "type": "boolean"
    },
    "status": {
      "enum": ["candidate", "verified", "frozen", "rejected"]
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "immutable": {
      "type": "boolean"
    },
    "version": {
      "type": "object",
      "required": ["version_id", "content_sha256", "retrieved_at"],
      "properties": {
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "published_at": {
      "type": "string",
      "format": "date"
    },
    "accessed_at": {
      "type": "string",
      "format": "date"
    },
    "doi": {
      "type": "string",
      "minLength": 1
    },
    "arxiv_id": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "rights": {
      "type": "object",
      "required": [
        "license_id",
        "evidence_url",
        "redistribution_allowed",
        "review_status"
      ],
      "properties": {
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_url": {
          "type": "string",
          "format": "uri"
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "review_status": {
          "enum": ["pending", "reviewed", "rejected"]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "immutable": {
            "const": false
          }
        },
        "required": ["immutable"]
      },
      "then": {
        "required": ["version"]
      }
    }
  ],
  "additionalProperties": false
}
