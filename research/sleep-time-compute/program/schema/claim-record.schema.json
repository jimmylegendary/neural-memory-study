{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-memory.local/schema/stc/claim-record.schema.json",
  "title": "Sleep-Time Compute Claim Record",
  "type": "object",
  "required": [
    "claim_id",
    "text",
    "claim_type",
    "status",
    "public",
    "load_bearing",
    "support"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^STC-C[0-9]{3,4}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": ["direct_fact", "author_claim", "synthesis", "hypothesis", "scenario"]
    },
    "status": {
      "enum": ["supported", "contested", "held", "rejected"]
    },
    "public": {
      "type": "boolean"
    },
    "load_bearing": {
      "type": "boolean"
    },
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "locator", "relation"],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-STC-[0-9]{4}$"
          },
          "locator": {
            "type": "string"
          },
          "relation": {
            "enum": ["supports", "qualifies", "contradicts", "context"]
          },
          "quote": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "scope_note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
