{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-memory.local/schema/stc/translation-selection.schema.json",
  "title": "Sleep-Time Compute Translation Selection",
  "type": "object",
  "required": ["schema_version", "selected"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paper_id", "source_id", "selection_reason", "status"],
        "properties": {
          "paper_id": {
            "type": "string",
            "pattern": "^STC-T[0-9]{2}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^SRC-STC-[0-9]{4}$"
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["selected", "reserve", "rejected"]
          },
          "exact_version": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "source_path": {
            "type": ["string", "null"]
          },
          "source_media": {
            "enum": ["PDF", "HTML"]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license_state": {
            "type": "string",
            "minLength": 1
          },
          "figure_count": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "equation_count": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "table_count": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "count_method": {
            "type": "string",
            "minLength": 1
          },
          "existing_translation": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
