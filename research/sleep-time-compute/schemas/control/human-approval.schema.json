{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/human-approval.schema.json",
  "title": "Signed human visual approval",
  "x-stc-owner": "publication",
  "x-stc-model": "HumanApproval",
  "type": "object",
  "properties": {
    "approval_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "subject_sha256": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "pdf_digests": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "machine_visual_report_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "contact_sheet_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "all_pages_reviewed": {
      "type": "boolean"
    },
    "review_checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
      }
    },
    "disposition": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "open_issues": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
      }
    },
    "signer_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "signer_role": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "algorithm": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "key_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "signature": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "signed_at": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/awareDateTime"
    }
  },
  "required": [
    "approval_id",
    "subject_sha256",
    "pdf_digests",
    "machine_visual_report_digest",
    "contact_sheet_digest",
    "all_pages_reviewed",
    "review_checks",
    "disposition",
    "open_issues",
    "signer_id",
    "signer_role",
    "algorithm",
    "key_id",
    "signature",
    "signed_at"
  ],
  "additionalProperties": false
}
