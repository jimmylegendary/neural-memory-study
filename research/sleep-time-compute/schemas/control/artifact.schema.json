{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/artifact.schema.json",
  "title": "Content-addressed artifact DAG node",
  "x-stc-owner": "artifact-dag",
  "x-stc-model": "ArtifactNode",
  "type": "object",
  "properties": {
    "artifact_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/artifactId"
    },
    "schema_version": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "artifact_type": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "path": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/relativePath"
    },
    "input_digests": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
      }
    },
    "producer_command": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "output_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "consumers": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/artifactId"
      },
      "uniqueItems": true
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/claimId"
      },
      "uniqueItems": true
    },
    "question_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/questionId"
      },
      "uniqueItems": true
    },
    "gate_status": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "owner": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "frozen_release_tag": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "required": [
    "artifact_id",
    "schema_version",
    "artifact_type",
    "path",
    "input_digests",
    "producer_command",
    "output_digest",
    "consumers",
    "claim_ids",
    "question_ids",
    "gate_status",
    "owner",
    "frozen_release_tag"
  ],
  "additionalProperties": false
}
