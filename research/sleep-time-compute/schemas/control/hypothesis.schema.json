{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/hypothesis.schema.json",
  "title": "Hypothesis record",
  "x-stc-owner": "research-program",
  "x-stc-model": "HypothesisRecord",
  "type": "object",
  "properties": {
    "hypothesis_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/hypothesisId"
    },
    "statement": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/evidenceId"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_anchor": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "estimand": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "null": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "rejection_rule": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "validity_failure": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "owner": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "artifact_dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/artifactId"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
      }
    },
    "derivation_artifact": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/artifactId"
    },
    "falsifier": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "confirmatory_cells": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "amendment_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/amendment"
      }
    }
  },
  "required": [
    "hypothesis_id",
    "statement",
    "evidence_ids",
    "evidence_anchor",
    "estimand",
    "null",
    "rejection_rule",
    "validity_failure",
    "owner",
    "artifact_dependencies",
    "assumptions",
    "derivation_artifact",
    "falsifier",
    "confirmatory_cells",
    "amendment_history"
  ],
  "additionalProperties": false,
  "$defs": {
    "amendment": {
      "type": "object",
      "properties": {
        "amended_at": {
          "type": "string",
          "format": "date-time"
        },
        "gate_id": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/gateId"
        },
        "reason": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
        },
        "confirmatory": {
          "type": "boolean"
        }
      },
      "required": ["amended_at", "gate_id", "reason", "confirmatory"],
      "additionalProperties": false
    }
  }
}
