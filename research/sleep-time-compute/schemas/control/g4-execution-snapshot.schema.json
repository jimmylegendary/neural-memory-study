{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/g4-execution-snapshot.schema.json",
  "title": "Frozen G4 execution snapshot",
  "x-stc-owner": "theory-benchmark",
  "x-stc-model": "G4ExecutionSnapshot",
  "type": "object",
  "properties": {
    "snapshot_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "commit_sha": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/gitSha1"
    },
    "tree_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "environment_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "experiment_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/DigestRef"
      },
      "minItems": 1
    },
    "container_image_digests": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "snapshot_id",
    "commit_sha",
    "tree_digest",
    "environment_digest",
    "experiment_refs",
    "container_image_digests",
    "created_at"
  ],
  "additionalProperties": false
}
