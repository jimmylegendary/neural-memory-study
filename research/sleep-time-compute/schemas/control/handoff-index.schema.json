{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/handoff-index.schema.json",
  "title": "Publication handoff index",
  "x-stc-owner": "publication",
  "x-stc-model": "HandoffIndex",
  "type": "object",
  "properties": {
    "handoff_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "scientific_candidate_sha": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/gitSha1"
    },
    "scientific_candidate_tree_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "release_manifest_ref": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/SubjectRef"
    },
    "schema_inventory_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/SubjectRef"
      },
      "minItems": 1
    },
    "reference_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/SubjectRef"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "handoff_id",
    "scientific_candidate_sha",
    "scientific_candidate_tree_digest",
    "release_manifest_ref",
    "schema_inventory_digest",
    "asset_refs",
    "reference_refs",
    "created_at"
  ],
  "additionalProperties": false
}
