{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/replay-report.schema.json",
  "title": "Clean release replay report",
  "x-stc-owner": "release-engineering",
  "x-stc-model": "ReplayReport",
  "type": "object",
  "properties": {
    "replay_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "candidate_ref": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/SubjectRef"
    },
    "environment_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    },
    "output_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/SubjectRef"
      },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "replay_id",
    "candidate_ref",
    "environment_digest",
    "steps",
    "output_refs",
    "status",
    "completed_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout_digest": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
        },
        "stderr_digest": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
        }
      },
      "required": ["command", "exit_code", "stdout_digest", "stderr_digest"],
      "additionalProperties": false
    }
  }
}
