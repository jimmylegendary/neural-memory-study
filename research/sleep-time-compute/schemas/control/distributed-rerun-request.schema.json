{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/distributed-rerun-request.schema.json",
  "title": "Distributed experiment rerun request",
  "x-stc-owner": "theory-benchmark",
  "x-stc-model": "DistributedRerunRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "experiment_bundle_ref": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/DigestRef"
    },
    "shard_count": {
      "type": "integer",
      "minimum": 1
    },
    "resource_class": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "seed_partition_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "requested_by": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "required": [
    "request_id",
    "experiment_bundle_ref",
    "shard_count",
    "resource_class",
    "seed_partition_digest",
    "requested_by",
    "requested_at",
    "deadline"
  ],
  "additionalProperties": false
}
