{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/manuscript-link.schema.json",
  "title": "Claim-to-manuscript link",
  "x-stc-owner": "publication",
  "x-stc-model": "ManuscriptLink",
  "type": "object",
  "properties": {
    "claim_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/claimId"
    },
    "manuscript_path": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/relativePath"
    },
    "location": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "sentence_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/evidenceId"
      },
      "uniqueItems": true
    },
    "artifact_dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/artifactId"
      },
      "uniqueItems": true
    },
    "last_verified": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/isoDate"
    }
  },
  "required": [
    "claim_id",
    "manuscript_path",
    "location",
    "sentence_digest",
    "evidence_ids",
    "artifact_dependencies",
    "last_verified"
  ],
  "additionalProperties": false
}
