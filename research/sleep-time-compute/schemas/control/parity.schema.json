{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/parity.schema.json",
  "title": "Publication parity check",
  "x-stc-owner": "publication",
  "x-stc-model": "ParityRecord",
  "type": "object",
  "properties": {
    "parity_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "left_ref": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/SubjectRef"
    },
    "right_ref": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/SubjectRef"
    },
    "check_kind": {
      "type": "string",
      "enum": ["CONTENT", "STRUCTURE", "CITATIONS", "EQUATIONS"]
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "parity_id",
    "left_ref",
    "right_ref",
    "check_kind",
    "status",
    "checked_at"
  ],
  "additionalProperties": false
}
