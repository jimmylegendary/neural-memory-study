{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/full-read-log.schema.json",
  "title": "Completed full-read log",
  "x-stc-owner": "evidence-governance",
  "x-stc-model": "FullReadLog",
  "type": "object",
  "properties": {
    "order_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "source_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sourceId"
    },
    "reviewed_version_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "reviewer": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/evidenceId"
      },
      "uniqueItems": true
    },
    "paper_card_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "disposition": {
      "type": "string",
      "enum": ["COMPLETE", "INCOMPLETE", "BLOCKED"]
    }
  },
  "required": [
    "order_id",
    "source_id",
    "reviewed_version_digest",
    "reviewer",
    "started_at",
    "completed_at",
    "evidence_ids",
    "paper_card_digest",
    "disposition"
  ],
  "additionalProperties": false
}
