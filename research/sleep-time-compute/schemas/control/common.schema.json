{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/common.schema.json",
  "title": "Sleep-Time Compute shared control definitions",
  "x-stc-owner": "evidence-governance",
  "x-stc-model": "CommonDefinitions",
  "type": "object",
  "properties": {},
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "stableId": {
      "type": "string",
      "pattern": "^(?:SRC-STC-(?!0000)[0-9]{4}|EV-STC-(?!00000)[0-9]{5}|CL-STC-(?!0000)[0-9]{4}|H-STC-(?!000)[0-9]{3}|PAPER-C[1-4]|RQ(?:[1-9]|1[0-2])|ART-STC-(?!0000)[0-9]{4}|EXP-STC-(?!0000)[0-9]{4}|RES-STC-(?!0000)[0-9]{4}|FIG-STC-(?!000)[0-9]{3}|TAB-STC-(?!000)[0-9]{3})$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^SRC-STC-(?!0000)[0-9]{4}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^EV-STC-(?!00000)[0-9]{5}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^(?:CL-STC-(?!0000)[0-9]{4}|PAPER-C[1-4])$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^RQ(?:[1-9]|1[0-2])$"
    },
    "hypothesisId": {
      "type": "string",
      "pattern": "^H-STC-(?!000)[0-9]{3}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^ART-STC-(?!0000)[0-9]{4}$"
    },
    "resultId": {
      "type": "string",
      "pattern": "^RES-STC-(?!0000)[0-9]{4}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha1": {
      "type": "string",
      "pattern": "^(?!0000000000000000000000000000000000000000$)[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)(?!.*//).+$"
    },
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "awareDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)(?!.*-00:00$)(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26]))|(?:(?:0[48]|[2468][048]|[13579][26])00))-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "isoDateOrDateTime": {
      "anyOf": [
        {
          "$ref": "#/$defs/isoDate"
        },
        {
          "$ref": "#/$defs/awareDateTime"
        }
      ]
    },
    "sourceGrade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "X"]
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["A-ABS", "A-HTML", "FULL", "REPRO"]
    },
    "warrant": {
      "type": "string",
      "enum": ["MEAS", "REPL", "DERIV", "SUMM", "SYNTH", "PROP"]
    },
    "reproductionStrength": {
      "type": "string",
      "enum": ["r0", "r1", "r2", "r3"]
    },
    "resultModality": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "SOURCE_REPORTED",
        "SIMULATED",
        "MODEL_ESTIMATED",
        "ANALYTICAL",
        "ACTUAL_MEASUREMENT",
        "ACTUAL_HARDWARE"
      ]
    },
    "evidenceRelation": {
      "type": "string",
      "enum": ["SUPPORTS", "CONTRADICTS", "QUALIFIES", "NON_CLAIM"]
    },
    "claimClass": {
      "type": "string",
      "enum": [
        "SOURCE-SUMMARY",
        "VENDOR-BEHAVIOR",
        "RERUN",
        "INDEPENDENT-REPLICATION",
        "ORIGINAL-MEASUREMENT",
        "ANALYTIC-DERIVATION",
        "TRACE-SIMULATION",
        "SYNTHESIS",
        "HYPOTHESIS"
      ]
    },
    "releaseStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "HYPOTHESIS",
        "UNRESOLVED",
        "SUPPORTED",
        "FALSIFIED/NARROWED",
        "BLOCKED",
        "WITHDRAWN"
      ]
    },
    "gateId": {
      "type": "string",
      "pattern": "^G[0-8]$"
    },
    "SubjectRef": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "SourceVersion": {
      "type": "object",
      "properties": {
        "identifier": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "public_date": {
          "type": "string",
          "minLength": 4
        },
        "date_precision": {
          "type": "string",
          "enum": ["YEAR", "MONTH", "DAY"]
        },
        "status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "canonical_url": {
          "type": ["string", "null"],
          "format": "uri",
          "minLength": 1
        },
        "local_artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "supersedes": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "derived_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "identifier",
        "public_date",
        "date_precision",
        "status",
        "canonical_url",
        "local_artifact_id",
        "sha256",
        "supersedes",
        "derived_from"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "date_precision": {
                "const": "YEAR"
              }
            },
            "required": ["date_precision"]
          },
          "then": {
            "properties": {
              "public_date": {
                "pattern": "^[0-9]{4}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "date_precision": {
                "const": "MONTH"
              }
            },
            "required": ["date_precision"]
          },
          "then": {
            "properties": {
              "public_date": {
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "date_precision": {
                "const": "DAY"
              }
            },
            "required": ["date_precision"]
          },
          "then": {
            "properties": {
              "public_date": {
                "$ref": "#/$defs/isoDate"
              }
            }
          }
        }
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "canonical_url": {
          "type": ["string", "null"],
          "format": "uri",
          "minLength": 1
        },
        "local_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "availability": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license_evidence_url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "license_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "license_review_disposition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rights_reviewer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rights_reviewed_at": {
          "$ref": "#/$defs/isoDateOrDateTime"
        },
        "rights_review_expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/isoDateOrDateTime"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "canonical_url",
        "local_path",
        "sha256",
        "media_type",
        "availability",
        "license_id",
        "license_evidence_url",
        "license_evidence_sha256",
        "redistribution_allowed",
        "license_review_disposition",
        "rights_reviewer",
        "rights_reviewed_at",
        "rights_review_expires_at"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "canonical_url": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "local_path": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ClaimResultProvenance": {
      "type": "object",
      "properties": {
        "asserted_modality": {
          "$ref": "#/$defs/resultModality"
        },
        "calibration_modalities": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/resultModality"
              },
              {
                "not": {
                  "const": "NOT_APPLICABLE"
                }
              }
            ]
          },
          "uniqueItems": true
        }
      },
      "required": ["asserted_modality", "calibration_modalities"],
      "additionalProperties": false
    },
    "ClaimSupportRef": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidenceId"
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_version_digest": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "support_span_digest": {
          "$ref": "#/$defs/sha256"
        },
        "relation": {
          "$ref": "#/$defs/evidenceRelation"
        },
        "role": {
          "type": "string",
          "enum": ["RELEASE_SUPPORT", "CONTEXT", "COUNTEREVIDENCE"]
        },
        "source_grade": {
          "$ref": "#/$defs/sourceGrade"
        },
        "warrant": {
          "$ref": "#/$defs/warrant"
        },
        "reproduction_strength": {
          "$ref": "#/$defs/reproductionStrength"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "source_version",
        "source_version_digest",
        "artifact_id",
        "support_span_digest",
        "relation",
        "role",
        "source_grade",
        "warrant",
        "reproduction_strength"
      ],
      "additionalProperties": false
    },
    "ClaimEvidenceRequirement": {
      "type": "object",
      "properties": {
        "allowed_claim_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimClass"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_source_grades": {
          "type": "array",
          "items": {
            "enum": ["A", "B", "C", "D"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_warrants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warrant"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minimum_reproduction_strength": {
          "$ref": "#/$defs/reproductionStrength"
        },
        "minimum_independent_sources": {
          "type": "integer",
          "minimum": 0
        },
        "requires_result_block": {
          "type": "boolean"
        },
        "minimum_independent_result_paths": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "allowed_claim_classes",
        "allowed_source_grades",
        "allowed_warrants",
        "minimum_reproduction_strength",
        "minimum_independent_sources",
        "requires_result_block",
        "minimum_independent_result_paths"
      ],
      "additionalProperties": false
    },
    "DigestRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["artifact_id", "sha256"],
      "additionalProperties": false
    }
  }
}
