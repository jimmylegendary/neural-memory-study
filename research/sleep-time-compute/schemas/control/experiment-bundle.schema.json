{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/experiment-bundle.schema.json",
  "title": "Digest-bound experiment bundle",
  "x-stc-owner": "theory-benchmark",
  "x-stc-model": "ExperimentBundle",
  "type": "object",
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-STC-(?!0000)[0-9]{4}$"
    },
    "schema_version": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "commit_sha": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/gitSha1"
    },
    "tree_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/DigestRef"
      },
      "minItems": 1
    },
    "environment_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "producer_command": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "expected_result_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/resultId"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "bundle_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    }
  },
  "required": [
    "experiment_id",
    "schema_version",
    "commit_sha",
    "tree_digest",
    "input_refs",
    "environment_digest",
    "producer_command",
    "seeds",
    "expected_result_ids",
    "bundle_digest"
  ],
  "additionalProperties": false
}
