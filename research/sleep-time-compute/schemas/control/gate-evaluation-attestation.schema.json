{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/gate-evaluation-attestation.schema.json",
  "title": "Gate evaluation attestation",
  "x-stc-owner": "gate-engine",
  "x-stc-model": "GateEvaluationAttestation",
  "type": "object",
  "properties": {
    "attestation_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "gate_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/gateId"
    },
    "subject_sha256": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/SubjectRef"
      },
      "minItems": 1
    },
    "signer_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "signer_role": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "independence_mode": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "algorithm": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "key_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "signature": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "signed_at": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/awareDateTime"
    }
  },
  "required": [
    "attestation_id",
    "gate_id",
    "subject_sha256",
    "subject_refs",
    "signer_id",
    "signer_role",
    "independence_mode",
    "algorithm",
    "key_id",
    "signature",
    "signed_at"
  ],
  "additionalProperties": false
}
