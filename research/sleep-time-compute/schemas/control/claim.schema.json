{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/claim.schema.json",
  "title": "Claim record",
  "x-stc-owner": "evidence-governance",
  "x-stc-model": "ClaimRecord",
  "type": "object",
  "properties": {
    "claim_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/claimId"
    },
    "statement": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "headline_quantitative": {
      "type": "boolean"
    },
    "claim_class": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/claimClass"
    },
    "result_provenance": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/ClaimResultProvenance"
    },
    "status": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/releaseStatus"
    },
    "scope": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sourceId"
      },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/evidenceId"
      },
      "uniqueItems": true
    },
    "support_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/ClaimSupportRef"
      }
    },
    "evidence_requirement": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/ClaimEvidenceRequirement"
    },
    "counterevidence_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/evidenceId"
      },
      "uniqueItems": true
    },
    "result_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/resultId"
      },
      "uniqueItems": true
    },
    "artifact_dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/artifactId"
      },
      "uniqueItems": true
    },
    "caveats": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
      }
    },
    "falsifier": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "paper_owner": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "gate_status": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "last_audit_date": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/isoDate"
    }
  },
  "required": [
    "claim_id",
    "statement",
    "headline_quantitative",
    "claim_class",
    "result_provenance",
    "status",
    "scope",
    "assumptions",
    "source_ids",
    "evidence_ids",
    "support_refs",
    "evidence_requirement",
    "counterevidence_ids",
    "result_ids",
    "artifact_dependencies",
    "caveats",
    "falsifier",
    "paper_owner",
    "gate_status",
    "last_audit_date"
  ],
  "additionalProperties": false
}
