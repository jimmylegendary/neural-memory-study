{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/claim-history.schema.json",
  "title": "Append-only claim history event",
  "x-stc-owner": "evidence-governance",
  "x-stc-model": "ClaimHistoryRecord",
  "type": "object",
  "properties": {
    "claim_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/claimId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event": {
      "type": "string",
      "enum": ["CREATED", "AMENDED", "STATUS_CHANGED", "WITHDRAWN"]
    },
    "status": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/releaseStatus"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "record_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "previous_digest": {
      "oneOf": [
        {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "claim_id",
    "sequence",
    "event",
    "status",
    "changed_at",
    "actor",
    "record_digest",
    "previous_digest"
  ],
  "additionalProperties": false
}
