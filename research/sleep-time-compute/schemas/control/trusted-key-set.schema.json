{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/trusted-key-set.schema.json",
  "title": "Trusted attestation key set",
  "x-stc-owner": "gate-engine",
  "x-stc-model": "TrustedKeySet",
  "type": "object",
  "properties": {
    "key_set_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/key"
      },
      "minItems": 1
    },
    "set_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "issued_at": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/awareDateTime"
    }
  },
  "required": ["key_set_id", "version", "keys", "set_digest", "issued_at"],
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "object",
      "properties": {
        "key_id": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
        },
        "signer_id": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
        },
        "algorithm": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
        },
        "public_key": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "valid_from": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/awareDateTime"
        },
        "valid_until": {
          "oneOf": [
            {
              "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/awareDateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "required": [
        "key_id",
        "signer_id",
        "algorithm",
        "public_key",
        "roles",
        "valid_from",
        "valid_until",
        "revoked"
      ],
      "additionalProperties": false
    }
  }
}
