{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/full-read-order.schema.json",
  "title": "Full-read work order",
  "x-stc-owner": "evidence-governance",
  "x-stc-model": "FullReadOrder",
  "type": "object",
  "properties": {
    "order_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "source_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sourceId"
    },
    "source_version_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "priority": {
      "type": "integer",
      "minimum": 1
    },
    "required_anchor_kinds": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assigned_to": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "status": {
      "type": "string",
      "enum": ["QUEUED", "IN_PROGRESS", "COMPLETE", "BLOCKED"]
    }
  },
  "required": [
    "order_id",
    "source_id",
    "source_version_digest",
    "priority",
    "required_anchor_kinds",
    "assigned_to",
    "status"
  ],
  "additionalProperties": false
}
