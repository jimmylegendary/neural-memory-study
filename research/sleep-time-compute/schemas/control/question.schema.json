{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/question.schema.json",
  "title": "Research question record",
  "x-stc-owner": "research-program",
  "x-stc-model": "QuestionRecord",
  "type": "object",
  "properties": {
    "question_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/questionId"
    },
    "statement": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "estimand": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "null": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "rejection_rule": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "minimum_effect": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "inconclusive_condition": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "validity_failure": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "owner": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "artifact_dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/artifactId"
      },
      "uniqueItems": true
    },
    "paper_scope": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    }
  },
  "required": [
    "question_id",
    "statement",
    "estimand",
    "null",
    "rejection_rule",
    "minimum_effect",
    "inconclusive_condition",
    "validity_failure",
    "owner",
    "artifact_dependencies",
    "paper_scope"
  ],
  "additionalProperties": false
}
