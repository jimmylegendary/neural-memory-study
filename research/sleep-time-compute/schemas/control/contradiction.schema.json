{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/contradiction.schema.json",
  "title": "Tracked evidence contradiction",
  "x-stc-owner": "evidence-governance",
  "x-stc-model": "ContradictionRecord",
  "type": "object",
  "properties": {
    "contradiction_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/claimId"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/evidenceId"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "summary": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "status": {
      "type": "string",
      "enum": ["OPEN", "QUALIFIED", "RESOLVED"]
    },
    "resolution": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "reviewed_at": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/isoDateOrDateTime"
    }
  },
  "required": [
    "contradiction_id",
    "claim_ids",
    "evidence_ids",
    "summary",
    "status",
    "resolution",
    "reviewed_at"
  ],
  "additionalProperties": false
}
