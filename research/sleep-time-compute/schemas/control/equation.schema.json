{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleep-time-compute.org/control/equation.schema.json",
  "title": "Publication equation record",
  "x-stc-owner": "publication",
  "x-stc-model": "EquationRecord",
  "type": "object",
  "properties": {
    "equation_id": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "latex": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
    },
    "semantic_digest": {
      "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/sha256"
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/claimId"
      },
      "uniqueItems": true
    },
    "artifact_dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/artifactId"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "equation_id",
    "latex",
    "semantic_digest",
    "symbols",
    "claim_ids",
    "artifact_dependencies"
  ],
  "additionalProperties": false,
  "$defs": {
    "symbol": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
        },
        "meaning": {
          "$ref": "https://schemas.sleep-time-compute.org/control/common.schema.json#/$defs/nonEmptyString"
        },
        "unit": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "required": ["name", "meaning", "unit"],
      "additionalProperties": false
    }
  }
}
